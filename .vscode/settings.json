{
  "prettier.requireConfig": true,
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[php]": {
    "editor.formatOnSave": false
  },
  "emeraldwalk.runonsave": {
    "ignoreUnchangedFiles": true,
    "commands": [
      {
        "match": "(?:[\\\\/](?:config|tests)[\\\\/].*|[\\\\/]web[\\\\/]app[\\\\/]themes[\\\\/]vite-wordpress[\\\\/].*|[\\\\/]web[\\\\/](?:index|wp-config))\\.php$",
        "notMatch": "[\\\\/](?:vendor|node_modules|web[\\\\/]wp|web[\\\\/]app[\\\\/](?:languages|plugins|mu-plugins|uploads))[\\\\/]",
        "cmd": "\"${workspaceFolder}/vendor/bin/pint\" --config \"${workspaceFolder}/pint.json\" \"${file}\"",
        "autoShowOutputPanel": "error"
      }
    ]
  }
}
