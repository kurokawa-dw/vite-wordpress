{
  "prettier.requireConfig": true,
  "prettier.prettierPath": "web/app/themes/vite-wordpress/node_modules/prettier",
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[php]": {
    "editor.defaultFormatter": "bmewburn.vscode-intelephense-client",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false
  },
  "files.readonlyInclude": {
    "**/node_modules/**/*": true,
    "vendor/**/*": true,
    "web/wp/**/*": true,
    "web/app/languages/**/*": true,
    "web/app/mu-plugins/**/*": true,
    "web/app/plugins/**/*": true,
    "web/app/themes/twentytwentyfive/**/*": true,
    "web/app/uploads/**/*": true
  },
  "php.validate.executablePath": "/Applications/MAMP/bin/php/php/bin/php",
  "intelephense.environment.phpVersion": "8.3.0",
  "intelephense.files.exclude": [
    "**/.git/**",
    "**/.svn/**",
    "**/.hg/**",
    "**/CVS/**",
    "**/.DS_Store/**",
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/web/app/languages/**",
    "**/web/app/mu-plugins/**",
    "**/web/app/plugins/**",
    "**/web/app/themes/twentytwentyfive/**",
    "**/web/app/uploads/**"
  ],
  "intelephense.format.braces": "per"
}
